    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0424\u0435\u0440\u0440 \u0437\u0430\u0434\u0443\u043C\u0447\u0438\u0432\u043E
      \u043F\u043E\u0432\u0435\u043B \u0447\u0435\u043B\u044E\u0441\u0442\u044C\u044E,
      \u0443\u0441\u0442\u0430\u0432\u0438\u043B\u0441\u044F \u0432 \u044D\u043A\u0440\u0430\u043D.
      \u0421\u0438\u043B\u044C\u0432\u0438 \u0437\u0430\u0435\u0440\u0437\u0430\u043B\u0430
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435, \u043F\u043E\u0434\u043E\u0448\u043B\u0430
      \u043F\u043E\u0431\u043B\u0438\u0436\u0435. "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\u041C\u043D\u0435 \u0432 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u044F\u0446\u0435
      \u0435\u0449\u0451 \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u043B\u0438
      \u0434\u0432\u0435 \u043D\u0435\u0434\u0435\u043B\u0438 \u043F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u044B\u0445
      \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u0438\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u043E\u0439.  "
