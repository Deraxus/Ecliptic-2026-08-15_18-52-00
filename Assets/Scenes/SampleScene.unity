  - id: 0
    frameType: 0
    dialogueText: "\u0422\u043A\u043D\u0443\u043B\u0430 \u0432 \u043A\u043E\u0440\u043F\u0443\u0441
      \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430, \u0434\u0432\u0430
      \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0430 \u0441\u0440\u0430\u0437\u0443
      \u0436\u0435 \u043F\u043E\u0434\u0434\u0430\u043B\u0438\u0441\u044C \u043F\u0440\u0438\u043A\u0430\u0437\u0443
      \u0438 \u0437\u0430\u0433\u043E\u0440\u0435\u043B\u0438\u0441\u044C. \u041E\u043D\u0430
      \u0443\u0441\u0435\u043B\u0430\u0441\u044C \u0432 \u043F\u043E\u0442\u0435\u0440\u0442\u043E\u0435
