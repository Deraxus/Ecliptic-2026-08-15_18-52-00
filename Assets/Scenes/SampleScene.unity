  - id: 0
    frameType: 0
    dialogueText: "\u0429\u0435\u043B\u0447\u043E\u043A. \u041C\u044F\u0433\u043A\u0438\u0435
      \u0438 \u0431\u0430\u0441\u0438\u0441\u0442\u044B\u0435 \u0448\u0430\u0433\u0438
      \u043F\u043E \u043A\u043E\u0432\u0440\u043E\u043B\u0438\u043D\u0443. \u0421\u0438\u043B\u044C\u0432\u0438
      \u043D\u0435\u0445\u043E\u0442\u044F \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C,
      \u0441\u043A\u0438\u043D\u0443\u043B\u0430 \u0441 \u0433\u043E\u043B\u043E\u0432\u044B
      \u043E\u0434\u0435\u044F\u043B\u043E \u0438 \u0440\u0430\u0437\u043B\u0435\u043F\u0438\u043B\u0430
      \u0432\u0435\u043A\u0438. \u0418 \u043C\u043E\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0430\u0441\u044C. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: 84c80b6cbb8f643429546a2b803dac98, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E \u0447\u0438\u0441\u0442\u043E\u0435
      \u0434\u0443\u043B\u043E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u043E \u043F\u0440\u044F\u043C\u043E
      \u043C\u0435\u0436\u0434\u0443 \u0435\u0435 \u0433\u043B\u0430\u0437. \u041E\u043D\u0430
      \u0441\u0436\u0430\u043B\u0430 \u043F\u0440\u043E\u0441\u0442\u044B\u043D\u0438
      \u0438 \u043D\u0435\u0431\u0440\u0435\u0436\u043D\u044B\u043C\u0438 \u0440\u044B\u0432\u043A\u0430\u043C\u0438
      \u043E\u0442\u043F\u043E\u043B\u0437\u043B\u0430 \u043A \u0441\u0442\u0435\u043D\u0435,
      \u043D\u043E \u043E\u0440\u0443\u0436\u0438\u0435 \u043F\u043E\u0441\u043B\u0443\u0448\u043D\u043E
      \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u043E \u0437\u0430 \u0435\u0435
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0446\u0435\u0439. \u041C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0432 \u0434\u043B\u0438\u043D\u043D\u043E\u043C \u043A\u043E\u0436\u0430\u043D\u043E\u043C
      \u043F\u043B\u0430\u0449\u0435 \u0431\u044B\u043B \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
      \u0441\u043F\u043E\u043A\u043E\u0435\u043D, \u043E\u0442\u0447\u0435\u0433\u043E
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u043E\u0441\u044C \u0435\u0449\u0435
      \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435. "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: 76f673c308ccb5242abda84d34675a47, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u041A\u0440\u0438\u043A\u043D\u0435\u0448\u044C \u2014 \u0437\u0430\u0441\u0442\u0440\u0435\u043B\u044E. "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: 76f673c308ccb5242abda84d34675a47, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u041A\u043E\u043B\u0435\u043D\u0438 \u043F\u0440\u043E\u0431\u0438\u043B\u0430
      \u0447\u0430\u0441\u0442\u0430\u044F \u0438 \u043D\u0435\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u0430\u044F
      \u0434\u0440\u043E\u0436\u044C. \u041C\u0443\u0436\u0447\u0438\u043D\u0430
      \u043E\u0433\u043B\u044F\u0434\u0435\u043B \u0442\u0440\u044F\u0441\u0443\u0449\u0443\u044E\u0441\u044F
      \u0432 \u0443\u0436\u0430\u0441\u0435 \u0434\u0435\u0432\u0443\u0448\u043A\u0443
      \u0441 \u043D\u043E\u0433 \u0434\u043E \u0433\u043E\u043B\u043E\u0432\u044B
      \u0438 \u0435\u043B\u0435 \u0432\u0438\u0434\u0438\u043C\u043E \u043D\u0430\u0445\u043C\u0443\u0440\u0438\u043B\u0441\u044F,
      \u0437\u0430\u0442\u0435\u043C \u0434\u0435\u0440\u043D\u0443\u043B \u043F\u043B\u0435\u0447\u043E\u043C
      \u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0439 \u0440\u0443\u043A\u043E\u0439
      \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0441\u044F \u043A \u043D\u0435\u0439."
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: 84c80b6cbb8f643429546a2b803dac98, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D \u0441\u0445\u0432\u0430\u0442\u0438\u043B \u0435\u0435
      \u0437\u0430 \u0432\u043E\u043B\u043E\u0441\u044B, \u0441\u0438\u043B\u043E\u0439
      \u0441\u0442\u044F\u043D\u0443\u043B \u0441 \u043F\u043E\u0441\u0442\u0435\u043B\u0438
      \u0438 \u0431\u0440\u043E\u0441\u0438\u043B \u043D\u0430 \u043F\u043E\u043B,
      \u0437\u0430\u0442\u0435\u043C \u043B\u0435\u0433\u043A\u0438\u043C \u0443\u0434\u0430\u0440\u043E\u043C
      \u0442\u0443\u043F\u043E\u0433\u043E \u043D\u043E\u0441\u043A\u0430 \u0435\u0433\u043E
      \u0431\u043E\u0442\u0438\u043D\u043A\u0430 \u0437\u0430\u0434\u0435\u043B \u043E\u0431\u043B\u0430\u0441\u0442\u044C
      \u0432\u043E\u043A\u0440\u0443\u0433 \u043F\u0435\u0447\u0435\u043D\u0438. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: 84c80b6cbb8f643429546a2b803dac98, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
