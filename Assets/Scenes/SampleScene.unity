  - id: 0
    frameType: 0
    dialogueText: "\u0417\u0430 \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u0441\u0435\u0440\u044B\u043C
      \u043E\u0444\u0438\u0441\u043D\u044B\u043C \u0441\u0442\u043E\u043B\u043E\u043C,
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044F\u0441\u044C \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u043C
      \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u043E\u043C, \u0441\u0438\u0434\u0435\u043B
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u043B\u0435\u0442 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438
      \u043F\u044F\u0442\u0438 \u0441 \u0443\u0445\u043E\u0436\u0435\u043D\u043D\u043E\u0439
      \u0437\u043E\u043B\u043E\u0442\u043E\u0439 \u0449\u0435\u0442\u0438\u043D\u043E\u0439,
      \u0442\u0430\u043A \u0438 \u043D\u0435 \u0434\u043E\u0440\u043E\u0441\u0448\u0435\u0439
      \u0434\u043E \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0439
      \u0431\u043E\u0440\u043E\u0434\u044B. \u041D\u0430 \u0432\u043E\u0448\u0435\u0434\u0448\u0443\u044E
      \u043A\u043E\u043B\u043B\u0435\u0433\u0443 \u043E\u043D \u043D\u0435 \u043E\u0431\u0440\u0430\u0442\u0438\u043B
      \u043D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F,
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B \u0447\u0442\u043E-\u0442\u043E
      \u0443\u0441\u0435\u0440\u0434\u043D\u043E \u043F\u0435\u0447\u0430\u0442\u0430\u0442\u044C.  "
