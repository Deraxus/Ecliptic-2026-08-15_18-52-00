        hideCharacters: 0
      - id: 0
        frameType: 0
        dialogueText: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u043D\u0430\u0441\u0435\u043B\u0430
          \u043D\u0430 \u0441\u0442\u043E\u043B \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430,
          \u0445\u043B\u043E\u043F\u043D\u0443\u0432 \u043F\u043E \u043D\u0435\u043C\u0443
          \u0440\u0443\u043A\u0430\u043C\u0438, \u0442\u043E\u0442 \u043E\u0442 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438
          \u043E\u0442\u043F\u0440\u044F\u043D\u0443\u043B. "
