  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u043F\u0440\u043E\u0448\u043B\u0430
      \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u0443\u0433\u043E\u043B \u043A\u043E\u043C\u043D\u0430\u0442\u044B,
      \u0434\u0435\u0440\u043D\u0443\u043B\u0430 \u043D\u0438\u0442\u044C \u0436\u0430\u043B\u044E\u0437\u0438
      \u0438 \u0442\u043A\u043D\u0443\u043B\u0430 \u0432 \u0444\u043E\u0440\u0442\u043E\u0447\u043A\u0443,
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u0436\u0430\u0434\u043D\u043E
      \u0432\u043E\u0440\u0432\u0430\u043B\u0441\u044F \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u044B\u0439
      \u0432\u043B\u0430\u0436\u043D\u044B\u0439 \u0432\u043E\u0437\u0434\u0443\u0445. "
