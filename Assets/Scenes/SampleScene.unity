  - id: 0
    frameType: 0
    dialogueText: "\u0428\u0438\u0440\u043E\u043A\u0438\u0439 \u043B\u0438\u0444\u0442,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0433 \u0443\u043C\u0435\u0441\u0442\u0438\u0442\u044C
      \u0432 \u0441\u0435\u0431\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C, \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0421\u0438\u043B\u044C\u0432\u0438 \u043D\u0430 \u0448\u0435\u0441\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439
      \u044D\u0442\u0430\u0436 \u0436\u0438\u043B\u043E\u0433\u043E \u043A\u043E\u0440\u043F\u0443\u0441\u0430.
      \u041E\u043D\u0430 \u043F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u043B\u0430
      \u0431\u0430\u043D\u043A\u0438 \u0432 \u043E\u0434\u043D\u0443 \u0440\u0443\u043A\u0443,
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0430
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0438\u0437 \u043A\u0430\u0440\u043C\u0430\u043D\u0430
      \u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u043B\u0430 \u043A \u043F\u0430\u043D\u0435\u043B\u0438
      \u0443 \u0434\u0432\u0435\u0440\u043D\u043E\u0439 \u0440\u0443\u0447\u043A\u0438.
      \u0417\u0430\u043C\u043E\u043A \u0437\u0430\u043F\u0438\u0449\u0430\u043B \u0438
      \u0449\u0435\u043B\u043A\u043D\u0443\u043B, \u0434\u0432\u0435\u0440\u044C
      \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C. "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: ac790543ea776344c923f1f877579420, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
