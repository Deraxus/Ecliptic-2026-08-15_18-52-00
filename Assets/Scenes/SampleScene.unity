  - id: 0
    frameType: 0
    dialogueText: "\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A \u0437\u0430\u0431\u0435\u0433\u0430\u043B
      \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438 \u043F\u043E \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435. "
    changeBackground: 0
