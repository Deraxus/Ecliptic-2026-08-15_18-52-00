    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u041E\u043D\u0430 \u0438\u0437 \u0431\u043E\u043B\u0435\u0435
      \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u043E\u0433\u043E \u043E\u0442\u0434\u0435\u043B\u0430
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
