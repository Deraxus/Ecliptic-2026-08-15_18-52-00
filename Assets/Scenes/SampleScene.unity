  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D\u0430 \u0442\u043A\u043D\u0443\u043B\u0430 \u0432
      \u0441\u043B\u0430\u0431\u043E \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u044B\u0435
      \u043A\u043D\u043E\u043F\u043A\u0438, \u0437\u0430\u043A\u0440\u044B\u043B\u0430
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0441\u043F\u043B\u044B\u0432\u0430\u044E\u0449\u0438\u0445
      \u043E\u043A\u043E\u043D \u0441 \u043D\u0435\u043F\u043E\u0434\u044A\u0435\u043C\u043D\u044B\u043C\u0438
      \u0441\u0443\u043C\u043C\u0430\u043C\u0438 \u043B\u044E\u043C\u0435\u043D\u043E\u0432,
      \u0438 \u043F\u0435\u0440\u0435\u0434 \u043D\u0435\u0439 \u0440\u0430\u0441\u043A\u0440\u044B\u043B\u0441\u044F
      \u0441\u043A\u0440\u043E\u043C\u043D\u043E \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u043D\u044B\u0439
      \u0441\u043F\u0438\u0441\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043E\u0431\u0440\u0430\u043C\u043B\u044F\u043B\u0430 \u0433\u0430\u043B\u0435\u0440\u0435\u044F
      \u0438\u0437 \u043D\u0435\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u043F\u0440\u0438\u0442\u044F\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0439. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
