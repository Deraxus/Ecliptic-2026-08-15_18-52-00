  - id: 0
    frameType: 1
    dialogueText: "\u201C\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u0430\u044F
      \u0440\u0435\u0437\u0435\u0440\u0432\u0430\u0446\u0438\u044F: \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0439
      \u043A\u043E\u043D\u0435\u0446 \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E\"
      \u0418 \u0447\u0442\u043E \u0442\u0430\u043C?\u201D "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 3
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u201C\u0422\u0440\u0435\u0445\u0440\u0430\u0437\u043E\u0432\u043E\u0435
      \u043F\u0438\u0442\u0430\u043D\u0438\u0435, \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u0430\u044F
      \u0436\u0438\u043B\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430,
      \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F \u0438 \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F.\u201D "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
