  - id: 0
    frameType: 0
    dialogueText: "\u0420\u0430\u0431\u043E\u0447\u0438\u0439 \u0434\u0435\u043D\u044C
      \u043F\u043E\u0434\u043E\u0448\u0435\u043B \u043A \u043A\u043E\u043D\u0446\u0443.
      \u0421\u0438\u043B\u044C\u0432\u0438\u044F \u0432 \u0447\u0435\u0442\u043A\u043E
      \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439 \u0447\u0430\u0441
      \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u043B\u0430 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440,
      \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0430 \u0441\u0443\u043C\u043A\u0443
      \u0441 \u0440\u0430\u0431\u043E\u0447\u0438\u043C \u043D\u043E\u0443\u0442\u0431\u0443\u043A\u043E\u043C,
      \u0437\u0430\u0434\u0432\u0438\u043D\u0443\u043B\u0430 \u043E\u0444\u0438\u0441\u043D\u043E\u0435
      \u043A\u0440\u0435\u0441\u043B\u043E \u0438 \u0437\u0430\u0441\u0435\u043C\u0435\u043D\u0438\u043B\u0430
      \u043A \u0432\u044B\u0445\u043E\u0434\u0443. "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 3
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u041F\u043E\u0433\u043E\u0434\u0430 \u0432 \u0434\u0435\u043B\u043E\u0432\u043E\u043C
      \u0440\u0430\u0439\u043E\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u0430
      \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u043E\u0439, \u043D\u043E
      \u043D\u0430 \u0435\u0433\u043E \u043E\u043A\u0440\u0430\u0438\u043D\u0435
      \u0443\u0436\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0438\u0441\u044C
      \u0437\u0430\u0431\u0440\u0435\u0434\u0448\u0438\u0435 \u0442\u0443\u0447\u0438.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044D\u0442\u0438 \u0441\u043A\u0438\u0442\u0430\u043B\u044C\u0446\u044B
      \u0440\u0435\u0448\u0438\u043B\u0438 \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0432 \u043F\u043B\u043E\u0442\u043D\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0438 \u043D\u043E\u0440\u043E\u0432\u0438\u043B\u043E \u043F\u0440\u043E\u043C\u043E\u0447\u0438\u0442\u044C
      \u043E\u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0421\u0430\u043D-\u041C\u043E\u043D\u0434.
      \u0421\u0438\u043B\u044C\u0432\u0438 \u0432\u0441\u043A\u0438\u043D\u0443\u043B\u0430
      \u0433\u043E\u043B\u043E\u0432\u0443 \u043A \u043D\u0435\u0431\u0443 \u2014
      \u0431\u0435\u0437\u043C\u044F\u0442\u0435\u0436\u043D\u044B\u0439 \u0433\u043E\u043B\u0443\u0431\u043E\u0439
      \u043F\u0435\u0440\u043B\u0430\u043C\u0443\u0442\u0440 \u041A\u0443\u043F\u043E\u043B\u0430
      \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430\u043B\u0441\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043F\u043B\u0430\u0432\u043D\u043E \u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E. "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: 762c35b2a6a36aa4793749843482c2b2, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
