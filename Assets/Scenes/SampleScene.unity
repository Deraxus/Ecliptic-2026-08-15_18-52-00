  - id: 0
    frameType: 0
    dialogueText: "\u041A\u0430\u0440\u0442\u0438\u043D\u043A\u0430 \u0441\u043C\u0435\u043D\u0438\u043B\u0430\u0441\u044C
      \u043D\u0430 \u0435\u0449\u0435 \u0431\u043E\u043B\u0435\u0435 \u043D\u0435\u043B\u0435\u043F\u0443\u044E
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: 5aef8628a33dd5a4f9a6155275418c3f, type: 2}
