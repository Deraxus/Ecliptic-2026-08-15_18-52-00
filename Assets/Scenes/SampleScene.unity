    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u042F \u0442\u0430\u043A\u043E\u0439 \u0437\u0430\u0434\u0430\u0447\u0438
      \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430 \u0443 \u043D\u0430\u0441. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
