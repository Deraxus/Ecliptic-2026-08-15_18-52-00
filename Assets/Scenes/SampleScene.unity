    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0433\u043B\u043E\u0442\u043E\u043A
      \u0434\u0435\u0440\u043D\u0443\u043B \u0433\u043E\u0440\u043B\u043E, \u0431\u0430\u043D\u043A\u0430
      \u0436\u0430\u043B\u043E\u0441\u0442\u043B\u0438\u0432\u043E \u043B\u044F\u0437\u0433\u043D\u0443\u043B\u0430
      \u043F\u043E\u0434 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438 \u0438
      \u043F\u043E\u043B\u0435\u0442\u0435\u043B\u0430 \u0432 \u043C\u0443\u0441\u043E\u0440\u043A\u0443,
      \u0447\u0442\u043E \u0441\u0442\u043E\u044F\u043B\u0430 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443.
      \u041D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0437\u0430\u0448\u0435\u043B\u0435\u0441\u0442\u0435\u043B
      \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439 \u043F\u043E\u043B\u0438\u044D\u0442\u0438\u043B\u0435\u043D\u043E\u0432\u044B\u0439
      \u043F\u0430\u043A\u0435\u0442, \u0438\u0437-\u043F\u043E\u0434 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0432\u044B\u0433\u043B\u044F\u043D\u0443\u043B \u0442\u0435\u043C\u043D\u044B\u0439
      \u043A\u043E\u043D\u0447\u0438\u043A \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043F\u0430\u044F\u043B\u044C\u043D\u0438\u043A\u0430, \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0433\u043E\u0440\u043A\u043E\u0439
      \u0438\u0437\u0443\u043C\u0440\u0443\u0434\u043D\u044B\u0445 \u043C\u0438\u043A\u0440\u043E\u0441\u0445\u0435\u043C. "
