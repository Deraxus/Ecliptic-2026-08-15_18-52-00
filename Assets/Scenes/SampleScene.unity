  - id: 0
    frameType: 0
    dialogueText: "\u041D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435 \u0432\u044B\u0441\u0432\u0435\u0442\u0438\u043B\u0430\u0441\u044C
      \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u0430\u044F \u0431\u0430\u043D\u043A\u0430
      \u0433\u0430\u0437\u0438\u0440\u043E\u0432\u043A\u0438, \u0441\u043A\u0430\u0447\u0443\u0449\u0430\u044F
