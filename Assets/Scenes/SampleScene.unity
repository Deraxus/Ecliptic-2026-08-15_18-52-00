  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u0442\u044F\u0436\u0435\u043B\u043E
      \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B\u0430, \u0443\u0441\u0442\u0430\u043B\u043E
