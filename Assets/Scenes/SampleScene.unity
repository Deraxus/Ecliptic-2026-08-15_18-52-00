  - id: 0
    frameType: 1
    dialogueText: "\u0410\u0433\u0430."
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: e83a1436f8bc63b4ba7569c0307559b2, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0420\u0430\u0437\u0434\u0430\u043B\u0438\u0441\u044C \u0442\u0440\u0438
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u0433\u0443\u0434\u043A\u0430
      \u0438 \u044D\u043A\u0440\u0430\u043D \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430
      \u043F\u043E\u0433\u0430\u0441. \u0414\u0435\u0432\u0443\u0448\u043A\u0430
      \u0443\u0441\u0442\u0430\u043B\u043E \u043F\u0440\u043E\u0432\u0435\u043B\u0430
      \u0440\u0443\u043A\u043E\u0439 \u043F\u043E \u043B\u0438\u0446\u0443, \u043F\u043E\u0442\u0435\u0440\u043B\u0430
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0446\u0443 \u0438 \u0442\u044F\u0436\u0435\u043B\u043E
      \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B\u0430. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: e83a1436f8bc63b4ba7569c0307559b2, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\u041A\u0438\u043B\u0431\u0440\u0430\u0439\u0434! "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0418\u0437-\u0437\u0430 \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E
      \u043E\u0442\u043A\u0440\u044B\u0432\u0448\u0435\u0439\u0441\u044F \u0434\u0432\u0435\u0440\u0438
      \u043E\u0444\u0438\u0441\u0430 \u0432\u044B\u0433\u043B\u044F\u043D\u0443\u043B
      \u0424\u0435\u0440\u0440. \u0421\u0438\u043B\u044C\u0432\u0438 \u043C\u0430\u0448\u0438\u043D\u0430\u043B\u044C\u043D\u043E
      \u0432\u044B\u043F\u0440\u044F\u043C\u0438\u043B\u0430\u0441\u044C, \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0430
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0432 \u043A\u0430\u0440\u043C\u0430\u043D. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\u0415\u0441\u0442\u044C \u0442\u0443\u0442 \u043E\u0434\u0438\u043D
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u2026 "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D \u043F\u043E\u0434\u043E\u0448\u0435\u043B \u043A
      \u043A\u043E\u043B\u043B\u0435\u0433\u0435 \u0438 \u043B\u0435\u043D\u0438\u0432\u043E
      \u043F\u043E\u0442\u0435\u0440 \u0448\u0435\u044E. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\u041D\u0430 \u043C\u0435\u043D\u044F \u0441\u0432\u0430\u043B\u0438\u043B\u0438
      \u043F\u0440\u043E\u0433\u043E\u043D \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u043E\u0432
      \u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u043A\u0430\u043D\u0430\u043B\u043E\u0432
      \u0440\u0435\u0437\u0435\u0440\u0432\u0430\u0446\u0438\u0438, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u043D\u0438\u043A\u0442\u043E \u0437\u0430 \u043D\u0435\u0435
      \u043D\u0435 \u0431\u0435\u0440\u0435\u0442\u0441\u044F, \u0430 \u044F \u0432
      \u0433\u043B\u0430\u0437\u0430 \u044D\u0442\u043E \u0433\u043E\u0432\u043D\u043E
      \u0432\u0438\u0434\u0435\u0442\u044C \u043D\u0435 \u043C\u043E\u0433\u0443. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u041C\u043D\u0435 \u0435\u0449\u0435 \u043A \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0435\u043C\u0443
      \u0443\u0442\u0440\u0443 \u043D\u0430\u0434\u043E \u0442\u0430\u0441\u043A\u0438
      \u043D\u0430\u0440\u0435\u0437\u0430\u0442\u044C \u043F\u043E \u043D\u043E\u0432\u043E\u0439
      \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0435. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
