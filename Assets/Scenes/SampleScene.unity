  - id: 0
    frameType: 0
    dialogueText: "\u0412 \u0441\u0430\u043C\u043E\u043C \u0446\u0435\u043D\u0442\u0440\u0435
      \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430,
      \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0447\u0438\u043C\u0438
      \u0441\u0442\u043E\u043B\u0430\u043C\u0438, \u0434\u0438\u0432\u0430\u043D\u0430\u043C\u0438,
      \u0436\u0438\u0432\u044B\u043C\u0438 \u0446\u0432\u0435\u0442\u0430\u043C\u0438
      \u0438 \u0443\u0441\u0442\u0430\u043B\u044B\u043C\u0438 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0430\u043C\u0438
      \u0441\u0442\u043E\u044F\u043B \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0446\u0438\u043B\u0438\u043D\u0434\u0440, \u0433\u043B\u0430\u0432\u043D\u0430\u044F
      \u0430\u0440\u0442\u0435\u0440\u0438\u044F \u0422\u0440\u0435\u0442\u044C\u0435\u0439
      \u0431\u0430\u0448\u043D\u0438. \u0421\u0438\u043B\u044C\u0432\u0438 \u0442\u043A\u043D\u0443\u043B\u0430
      \u043A\u0440\u0443\u0433\u043B\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443
      \u2014 \u043F\u0435\u0440\u0435\u0434 \u043D\u0435\u0439 \u043F\u043B\u0430\u0432\u043D\u043E
      \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C \u0441\u0442\u0432\u043E\u0440\u043A\u0438
      \u043B\u0438\u0444\u0442\u0430. "
