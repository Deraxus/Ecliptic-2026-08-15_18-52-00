  - id: 0
    frameType: 0
    dialogueText: "\u041C\u0435\u0442\u0440\u043E \u043F\u043E\u0445\u043E\u0434\u0438\u043B\u043E
      \u043D\u0430 \u0440\u0430\u0437\u0432\u043E\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
      \u0443\u043B\u0435\u0439. \u0421\u0438\u043B\u044C\u0432\u0438 \u0442\u0435\u043A\u043B\u0430
      \u0437\u0430 \u043F\u043E\u0442\u043E\u043A\u043E\u043C \u043A \u043D\u0443\u0436\u043D\u043E\u043C\u0443
      \u043F\u043E\u0435\u0437\u0434\u0443, \u0448\u0430\u043D\u0441\u0430 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043D\u0435 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u043E\u0441\u044C. "
