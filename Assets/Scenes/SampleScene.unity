  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D\u0430 \u0437\u0430\u0442\u0430\u0440\u0430\u0445\u0442\u0435\u043B\u0430
      \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438 \u043F\u043E \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435,
      \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C \u044D\u043A\u0440\u0430\u043D\u0435
      \u0432\u044B\u0441\u0432\u0435\u0442\u0438\u043B\u0441\u044F \u043D\u0443\u0434\u043D\u044B\u0439
      \u0438 \u043F\u043B\u043E\u0441\u043A\u0438\u0439 \u0442\u0435\u043A\u0441\u0442
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438, \u0437\u0430\u0442\u0435\u043C
      \u0444\u0430\u0439\u043B \u0441 \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u043C\u0438
      \u0438 \u043E\u0436\u0438\u0434\u0430\u0435\u043C\u044B\u043C\u0438 \u0434\u0430\u043D\u043D\u044B\u043C\u0438. "
