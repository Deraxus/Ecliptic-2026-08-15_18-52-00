    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u0432\u0434\u043E\u0445\u043D\u0443\u043B\u0430,
      \u043D\u043E \u0441\u0438\u043B \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u0442\u044C
      \u043D\u0435 \u043D\u0430\u0448\u043B\u0430. \u041E\u043D\u0430 \u0442\u044F\u0436\u0435\u043B\u043E
      \u043F\u0440\u0438\u0441\u043B\u043E\u043D\u0438\u043B\u0430\u0441\u044C \u0441\u043F\u0438\u043D\u043E\u0439
      \u043A \u0442\u043E\u043D\u043A\u043E\u0439 \u0441\u0435\u0440\u043E\u0439
      \u0441\u0442\u0435\u043D\u0435, \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u0435\u0441\u043B\u0438 \u043D\u0430\u0434\u0430\u0432\u0438\u0442\u044C \u043D\u0430
      \u043D\u0435\u0435 \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u2014 \u043E\u043D\u0430
      \u043F\u043E\u0440\u0432\u0435\u0442\u0441\u044F \u0431\u0443\u043C\u0430\u0433\u043E\u0439. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\u0414\u0436\u043E, \u043E\u043D\u0438 \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C
      \u043D\u0443\u0436\u043D\u044B\u2026 \u0421\u0435\u0439\u0447\u0430\u0441 \u0442\u043E\u0447\u043D\u043E
      \u043E\u0447\u0435\u043D\u044C\u2026 "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438 \u0443 \u0441\u0432\u043E\u0435\u0439
      \u0434\u0440\u0430\u0436\u0430\u0439\u0448\u0435\u0439 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438.
      \u042F \u043D\u0430 \u043C\u0435\u043B\u0438. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
