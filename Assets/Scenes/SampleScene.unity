    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u0441\u043A\u0443\u043A\u043E\u0436\u0438\u043B\u0430\u0441\u044C,
      \u043D\u043E \u0434\u0430\u0436\u0435 \u043D\u0435 \u043F\u0438\u0441\u043A\u043D\u0443\u043B\u0430.
