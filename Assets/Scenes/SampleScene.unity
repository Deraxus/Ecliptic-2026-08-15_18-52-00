    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u0418 \u0432\u043C\u0435\u0441\u0442\u043E \u043F\u043B\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u044F \u0432 \u043A\u043E\u043D\u0446\u0435
      \u043F\u0438\u0441\u044C\u043C\u0430 \u0442\u044F\u043D\u0443\u043B\u0430\u0441\u044C
      \u0434\u043B\u0438\u043D\u043D\u0430\u044F \u0441\u0442\u0440\u043E\u043A\u0430
      \u0438\u0437 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u0431\u0435\u0437\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0433\u043E
      \u043D\u0430\u0431\u043E\u0440\u0430 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u041D\u0430\u0442\u044F\u043D\u0443\u0442\u044B\u0435 \u0441\u0442\u0440\u0443\u043D\u044B
      \u043F\u043E\u0434 \u043B\u043E\u0436\u0435\u0447\u043A\u043E\u0439 \u0442\u0430\u043A
      \u0438 \u043D\u0435 \u043E\u0441\u043B\u0430\u0431\u043B\u0438, \u043D\u043E
      \u043F\u043E\u0434 \u0433\u043D\u0435\u0442\u043E\u043C \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E
      \u0441\u0442\u0430\u043B\u043E \u043B\u0435\u0433\u0447\u0435. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u0421\u043E\u043B\u043D\u0446\u0435 \u0434\u0430\u0432\u043D\u043E
      \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u043E\u0441\u044C \u0437\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442,
      \u043D\u043E \u0441\u0432\u0435\u0442 \u0438\u0437 \u043E\u043A\u043D\u0430
      \u0432\u0441\u0435 \u0435\u0449\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u043B
      \u0443\u044E\u0442\u043D\u043E\u0435 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0445
      \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u043E\u0432, \u0432\u0448\u0438\u0442\u044B\u0445
      \u0432 \u043F\u043E\u0442\u043E\u043B\u043E\u043A. \u0421\u0438\u043B\u044C\u0432\u0438
      \u0432\u044B\u0442\u044F\u043D\u0443\u043B\u0430 \u0440\u0443\u043A\u0438 \u0438
      \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0430\u0441\u044C, \u043F\u0430\u0440\u0430
      \u0441\u0443\u0441\u0442\u0430\u0432\u043E\u0432 \u0445\u0440\u0443\u0441\u0442\u043D\u0443\u043B\u0430
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u0441\u043F\u0438\u043D\u043A\u043E\u0439
      \u0441\u0442\u0443\u043B\u0430. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\u201C\u041F\u043B\u0435\u0432\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430,
      \u0447\u0435\u0433\u043E \u0435\u0435 \u043F\u0435\u0440\u0435\u043A\u0438\u0434\u044B\u0432\u0430\u043B\u0438
      \u0438\u0437 \u0440\u0443\u043A \u0432 \u0440\u0443\u043A\u0438?\u201D "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
