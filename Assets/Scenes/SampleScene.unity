  - id: 0
    frameType: 0
    dialogueText: "\xAB\u0423\u0432\u0430\u0436\u0430\u0435\u043C\u0430\u044F \u0421\u0438\u043B\u044C\u0432\u0438\u044F
      \u041A\u0438\u043B\u0431\u0440\u0430\u0439\u0434! \u0412 \u0441\u0432\u044F\u0437\u0438
      \u0441 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0435\u043C
      \u0420\u0435\u0437\u0435\u0440\u0432\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
      \u043F\u043E\u0440\u043E\u0433\u0430 \u043E\u0431\u044F\u0437\u0430\u043D\u044B
      \u0443\u0432\u0435\u0434\u043E\u043C\u0438\u0442\u044C \u0412\u0430\u0441,
      \u0447\u0442\u043E \u0412\u0430\u0448 \u043F\u0440\u043E\u0444\u0438\u043B\u044C
      \u043F\u0435\u0440\u0435\u0439\u0434\u0435\u0442 \u0432 \u043F\u0440\u0435\u0434\u0440\u0435\u0437\u0435\u0440\u0432\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
      \u0440\u0435\u0436\u0438\u043C \u0447\u0435\u0440\u0435\u0437: 11 \u0434\u043D\u0435\u0439.
      \u0427\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C \u043E\u0431
      \u044D\u0442\u043E\u043C \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435,
      \u043E\u0437\u043D\u0430\u043A\u043E\u043C\u044C\u0442\u0435\u0441\u044C \u0441\u043E
      \u0441\u0442\u0430\u0442\u044C\u0435\u0439 \xAB\u0420\u0435\u0437\u0435\u0440\u0432\u0430\u0446\u0438\u044F.
      \u0421\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0439 \u043A\u043E\u043D\u0435\u0446
      \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E\xBB \u043D\u0430
      \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C \u0441\u0430\u0439\u0442\u0435
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \xABEon Industries\xBB \u0438\u043B\u0438
      \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u0435\u0441\u044C \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u0432 \u043B\u044E\u0431\u043E\u0439 \u043E\u0444\u0438\u0441 \xABRight in
      Time\xBB.  "
