        clothesType: 0
        emotion: 4
        choices: []
        hideCharacters: 1
      - id: 0
        frameType: 1
        dialogueText: "\u041D\u0435 \u0431\u044B\u043B\u043E \u0440\u0430\u043D\u044C\u0448\u0435
