    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u041D\u0443, \u043A\u0440\u0443\u0442\u043E. \u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430. "
    changeBackground: 0
