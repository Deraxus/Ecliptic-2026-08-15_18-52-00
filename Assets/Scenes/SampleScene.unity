  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C
      \u043D\u0430 \u0441\u0442\u043E \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439
      \u044D\u0442\u0430\u0436 \u2014 \u0441\u0430\u043C\u043E\u0435 \u0434\u043D\u043E
      \u0432\u044B\u0441\u0448\u0435\u0439 \u043B\u0438\u0433\u0438. \u041E\u0444\u0438\u0441
      \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E \u0441\u0434\u0430\u0432\u0438\u043B
      \u0432 \u043F\u043B\u0435\u0447\u0430\u0445, \u0421\u0438\u043B\u044C\u0432\u0438
      \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043D\u0430 \u0444\u0443\u0442\u0431\u043E\u043B\u044C\u043D\u043E\u043C \u043F\u043E\u043B\u0435,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0441\u0442\u0430\u043B\u043E \u0442\u044F\u0436\u0435\u043B\u043E
      \u0434\u044B\u0448\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0438 \u0432\u044B\u0441\u043E\u043A\u0438\u0445
      \u043A\u0430\u0440\u0442\u043E\u043D\u043D\u044B\u0445 \u0441\u0442\u0435\u043D
      \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0446\u0432\u0435\u0442\u0430.
      \u041E\u043D\u0430 \u043F\u043E\u0441\u0442\u0443\u0447\u0430\u043B\u0430\u0441\u044C
      \u0432 \u0433\u043B\u0430\u0434\u043A\u0443\u044E \u0442\u0435\u043C\u043D\u0443\u044E
      \u0434\u0432\u0435\u0440\u044C \u0438 \u0441\u0440\u0430\u0437\u0443 \u0436\u0435
      \u043E\u0442\u043A\u0440\u044B\u043B\u0430 \u0435\u0435, \u043D\u0435 \u0434\u043E\u0436\u0438\u0434\u0430\u044F\u0441\u044C
      \u043E\u0442\u043A\u043B\u0438\u043A\u0430. "
