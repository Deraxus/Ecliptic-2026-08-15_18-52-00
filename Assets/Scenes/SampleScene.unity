        dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u0434\u0435\u0440\u043D\u0443\u043B\u0430
          \u0433\u0443\u0431\u0430\u043C\u0438, \u0443\u043A\u0443\u0441\u0438\u043B\u0430
          \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044E\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443
          \u0449\u0435\u043A\u0438, \u0438 \u0441\u043C\u0435\u043D\u0438\u043B\u0430
          \u043A\u0443\u0440\u0441. "
        changeBackground: 0
        frameBackground: {fileID: 0}
        character: {fileID: 0}
        characterSide: 0
        clothesType: 0
        emotion: 0
        choices: []
        hideCharacters: 1
      - id: 0
        frameType: 0
        dialogueText: "\u041E\u043D\u0430 \u0448\u043B\u0430 \u043C\u0435\u0436\u0434\u0443
          \u043F\u043E\u043B\u043E\u043A \u0441 \u0440\u0430\u0437\u043D\u043E\u0446\u0432\u0435\u0442\u043D\u044B\u043C\u0438
          \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0430\u043C\u0438, \u0432\u0441\u0435
          \u0435\u0449\u0435 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044F\u0441\u044C
          \u043A\u0443\u0440\u0442\u043A\u043E\u0439, \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C
          \u0443 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0430
          \u0441 \u0433\u0430\u0437\u0438\u0440\u043E\u0432\u043A\u0430\u043C\u0438.
          \u0424\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0445 \u0431\u0430\u043D\u043E\u043A
          \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u043E\u0441\u044C \u0448\u0442\u0443\u043A
          \u043F\u044F\u0442\u044C. \u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0430
          \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u0443\u044E \u0434\u0432\u0435\u0440\u0446\u0443,
          \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0430 \u0442\u0440\u0438 \u0433\u0430\u0437\u0438\u0440\u043E\u0432\u043A\u0438
          \u0438 \u043A\u043E\u043B\u0435\u043D\u043E\u043C \u0437\u0430\u0445\u043B\u043E\u043F\u043D\u0443\u043B\u0430
          \u0435\u0435. "
        changeBackground: 1
        frameBackground: {fileID: 11400000, guid: 9d7f195f62639ff48828e5b50311f805, type: 2}
        character: {fileID: 0}
        characterSide: 0
        clothesType: 0
        emotion: 0
        choices: []
        hideCharacters: 1
      - id: 0
        frameType: 0
        dialogueText: "\u041E\u043D\u0430 \u043F\u043E\u0434\u043E\u0448\u043B\u0430
          \u043A \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u043E\u043C\u0443 \u044D\u043A\u0440\u0430\u043D\u0443,
          \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0442\u043E\u0432\u0430\u0440
          \u043D\u0430 \u0441\u0442\u043E\u043B, \u0438 \u043F\u0435\u0440\u0435\u0434
          \u043D\u0435\u0439 \u0432\u044B\u0441\u0432\u0435\u0442\u0438\u043B\u0441\u044F
          \u0441\u043A\u0443\u0434\u043D\u044B\u0439 \u0441\u043F\u0438\u0441\u043E\u043A
          \u0438 \u0433\u0440\u043E\u043C\u043E\u0437\u0434\u043A\u0430\u044F \u043D\u0430\u0434\u043F\u0438\u0441\u044C:
          \"\u0410\u041A\u0426\u0418\u042F! +15 \u043C\u0438\u043D\u0443\u0442 \u0412
          \u041F\u041E\u0414\u0410\u0420\u041E\u041A!\" \u041E\u043D\u0430 \u043F\u0430\u0440\u0443
          \u0440\u0430\u0437 \u0442\u043A\u043D\u0443\u043B\u0430 \u0432 \u044D\u043A\u0440\u0430\u043D,
          \u0434\u0435\u0440\u043D\u0443\u043B\u0430 \u0440\u0443\u043A\u0430\u0432
          \u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u043B\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435
          \u043A \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u043E\u043C\u0443 \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u0443,
          \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u043D\u043E\u043C\u0443
          \u0441\u0431\u043E\u043A\u0443. \u0420\u0430\u0437\u0434\u0430\u043B\u0441\u044F
          \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0442\u0438\u0445\u0438\u0439
          \u0437\u0432\u043E\u043D, \u0438 \u0434\u0435\u0432\u0443\u0448\u043A\u0430
          \u043F\u043E\u0441\u043F\u0435\u0448\u043D\u043E \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0430
          \u043F\u043E\u043A\u0443\u043F\u043A\u0443 \u0438 \u0432\u044B\u0448\u043B\u0430
          \u0438\u0437 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430. "
        changeBackground: 1
        frameBackground: {fileID: 11400000, guid: 9d7f195f62639ff48828e5b50311f805, type: 2}
