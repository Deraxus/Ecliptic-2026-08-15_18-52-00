  - id: 0
    frameType: 0
    dialogueText: "\u041E\u0447\u0435\u0440\u0441\u0442\u0432\u0435\u0432\u0448\u0438\u0439
      \u043C\u043E\u0437\u0433 \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0437\u0430\u0449\u0435\u043A\u043E\u0442\u0430\u043B\u043E,
      \u0442\u0430\u043A\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u043B\u0438
      \u0421\u0438\u043B\u044C\u0432\u0438 \u0431\u0435\u0437\u043C\u0435\u0440\u043D\u043E\u0435
      \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435, \u0438
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0430\u0440\u0443 \u0447\u0430\u0441\u043E\u0432
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u0431\u044B\u043B\u0430
      \u0433\u043E\u0442\u043E\u0432\u0430. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
