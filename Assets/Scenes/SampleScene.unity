  - id: 0
    frameType: 1
    dialogueText: "\u0414\u0430, \u041A\u0438\u043B\u0431\u0440\u0430\u0439\u0434.
      \u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435? "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u0441\u043B\u043E\u0436\u0438\u043B\u0430
      \u0440\u0443\u043A\u0438 \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439,
      \u0442\u0430\u0439\u043A\u043E\u043C \u043D\u0430\u0442\u044F\u043D\u0443\u043B\u0430
      \u0440\u0443\u043A\u0430\u0432 \u043A\u0443\u0440\u0442\u043A\u0438, \u0441\u043A\u0440\u044B\u0432\u0430\u044F
      \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435 \u0438\u043C\u043F\u043B\u0430\u043D\u0442\u0430. "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\u0425\u043E\u0442\u0435\u043B\u0430 \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C,
      \u0430 \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0443
      \u043F\u0440\u0438\u0441\u043B\u0430\u0442\u044C \u043F\u043E\u0440\u0430\u043D\u044C\u0448\u0435?
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F-\u0437\u0430\u0432\u0442\u0440\u0430? "
    changeBackground: 0
    frameBackground: {fileID: 0}
