  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u0437\u0430\u0442\u043A\u043D\u0443\u043B\u0430
      \u0443\u0448\u0438 \u043C\u0443\u0437\u044B\u043A\u043E\u0439, \u043D\u0430\u0442\u044F\u043D\u0443\u043B\u0430
      \u043A\u0443\u0440\u0442\u043A\u0443 \u043D\u0430 \u043C\u0430\u043A\u0443\u0448\u043A\u0443
      \u0438 \u043F\u0435\u0440\u0435\u0431\u0435\u0436\u0430\u043B\u0430 \u043D\u0430
      \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
      \u043E\u0431\u044B\u0434\u0435\u043D\u043D\u043E \u043F\u0440\u043E\u0438\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0432
      \u043F\u0440\u043E\u0442\u044F\u0436\u043D\u044B\u0439 \u0433\u0443\u0434\u043E\u043A
      \u043C\u0430\u0448\u0438\u043D. "
    changeBackground: 0
