    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u0441\u043D\u043E\u0432\u0430
      \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D,
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u043F\u043E\u0433\u043B\u0430\u0434\u0438\u043B\u0430
      \u044D\u043A\u0440\u0430\u043D \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043F\u0430\u043B\u044C\u0446\u0435\u043C,
      \u0438 \u043D\u0430 \u043D\u0435\u043C \u043A\u0440\u0443\u043F\u043D\u044B\u043C
      \u0448\u0440\u0438\u0444\u0442\u043E\u043C \u0432\u044B\u0441\u0432\u0435\u0442\u0438\u043B\u043E\u0441\u044C
      \u0434\u0432\u0443\u0437\u043D\u0430\u0447\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E
      \u0438 \u043F\u0435\u0440\u0435\u0447\u0435\u0440\u043A\u043D\u0443\u0442\u0430\u044F
      \u0431\u0443\u043A\u0432\u0430 L, \u044D\u0442\u0438\u0445 \u0434\u0435\u043D\u0435\u0433
      \u0435\u0434\u0432\u0430 \u043C\u043E\u0433\u043B\u043E \u0445\u0432\u0430\u0442\u0438\u0442\u044C
      \u043D\u0430 \u0435\u0434\u0443 \u043D\u0430 \u0434\u0435\u043D\u044C. \u0414\u0435\u0432\u0443\u0448\u043A\u0430
      \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u043B\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D
      \u0438 \u0432\u044B\u043F\u0440\u044F\u043C\u0438\u043B\u0430\u0441\u044C,
      \u0441\u0436\u0430\u043B\u0430 \u0432\u0437\u043E\u043F\u0440\u0435\u0432\u0448\u0443\u044E
      \u043B\u0430\u0434\u043E\u043D\u044C \u0432 \u043A\u0443\u043B\u0430\u043A. "
