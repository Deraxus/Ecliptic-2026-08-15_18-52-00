  - id: 0
    frameType: 0
    dialogueText: "\u0414\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u043E \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044B\u0439
      \u044D\u0442\u0430\u0436 \u043E\u0444\u0438\u0441\u043D\u043E\u0439 \u0431\u0430\u0448\u043D\u0438
      \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0438\u043A\u0438
      RiT. \u041F\u0430\u043D\u043E\u0440\u0430\u043C\u043D\u044B\u0435 \u043E\u043A\u043D\u0430
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u044D\u0442\u0430\u0436\u0443
      \u0432\u043C\u0435\u0441\u0442\u043E \u0441\u0442\u0435\u043D \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u043B\u0438
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u043F\u043E\u043B\u0435\u0442\u0430,
      \u043D\u043E \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435 \u043D\u0435\u0431\u043E\u0441\u043A\u0440\u0435\u0431\u044B
      \u044F\u0432\u043D\u043E \u043F\u043E\u043C\u0435\u0448\u0430\u043B\u0438 \u0437\u0430\u0434\u0443\u043C\u043A\u0435
      \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0430 \u0434\u0430\u0442\u044C
      \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C \u043A\u043E\u043C\u0444\u043E\u0440\u0442
      \u0432 \u0438\u043B\u043B\u044E\u0437\u0438\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u044B.
      \u0421\u0438\u043B\u044C\u0432\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0443\u043F\u0438\u043B\u0430
      \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u0432\u0448\u0435\u0433\u043E\u0441\u044F
      \u043D\u0430 \u043F\u0443\u0444\u0438\u043A\u0435 \u043A\u043E\u043B\u043B\u0435\u0433\u0443,
      \u0447\u0442\u043E-\u0442\u043E \u043B\u0435\u043D\u0438\u0432\u043E \u043F\u0435\u0447\u0430\u0442\u0430\u044E\u0449\u0435\u043C
      \u043D\u0430 \u043D\u043E\u0443\u0442\u0431\u0443\u043A\u0435. "
