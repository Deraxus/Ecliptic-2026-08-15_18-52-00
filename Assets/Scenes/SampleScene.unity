  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D\u0430 \u043F\u043E\u043A\u0440\u0443\u0442\u0438\u043B\u0430
      \u043F\u043E\u0442\u0435\u0440\u0442\u044B\u0439 \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B
      \u0432 \u0440\u0443\u043A\u0430\u0445 \u0438 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u043B\u0430
      \u043A \u043D\u0435\u043C\u0443 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043F\u0440\u043E\u0432\u043E\u0434\u043E\u043A, \u043F\u0435\u0440\u0435\u043F\u0430\u044F\u043D\u043D\u044B\u0439
      \u0432 \u0434\u0432\u0443\u0445 \u043C\u0435\u0441\u0442\u0430\u0445. "
