  - id: 0
    frameType: 0
    dialogueText: "\u0413\u043B\u0430\u0437\u0430 \u0437\u0430\u0431\u0435\u0433\u0430\u043B\u0438
      \u043F\u043E \u043E\u0442\u0447\u0435\u0442\u0443, \u0440\u0443\u043A\u0438
      \u043C\u0430\u0448\u0438\u043D\u0430\u043B\u044C\u043D\u043E \u043D\u0430\u0447\u0430\u043B\u0438
      \u043E\u0444\u043E\u0440\u043C\u043B\u044F\u0442\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
      \u043E\u0431 \u043E\u0448\u0438\u0431\u043A\u0435, \u043D\u043E \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C.
      \u0421\u0438\u043B\u044C\u0432\u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430 \u043A \u0441\u0435\u0431\u0435
      \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
