  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D\u0430 \u0441\u0443\u043D\u0443\u043B\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D
      \u0432 \u043A\u0430\u0440\u043C\u0430\u043D, \u0432\u0441\u0442\u0430\u043B\u0430
      \u0441 \u043C\u0435\u0441\u0442\u0430 \u0438 \u043F\u0440\u043E\u0432\u0435\u043B\u0430
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E \u044D\u043A\u0440\u0430\u043D\u0443
      \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0430 \u2014 \u0442\u043E\u0442
      \u043F\u043E\u0433\u0430\u0441, \u0441\u043A\u0440\u044B\u0432\u0430\u044F
      \u0437\u0430 \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u043C \u0441\u0442\u0435\u043A\u043B\u043E\u043C
      \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0449\u0438\u0445 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445
      \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u043E\u0432. "
