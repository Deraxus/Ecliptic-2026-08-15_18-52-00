    characterSide: 1
    clothesType: 0
    emotion: 4
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\u042F \u0441\u043F\u0440\u043E\u0441\u0438\u043B, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u0443 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u0438,
      \u043C\u043E\u0436\u043D\u043E \u043B\u0438 \u043E\u0431\u043E\u0439\u0442\u0438.
      \u0417\u0430\u0440\u043F\u043B\u0430\u0442\u0430 \u043F\u043E\u0437\u0436\u0435,
      \u0447\u0435\u043C \u043F\u043E\u0440\u043E\u0433, \u0431\u043E\u044E\u0441\u044C\u2026 "
