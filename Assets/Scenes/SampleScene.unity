  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0441\u043D\u0443\u043B\u0430\u0441\u044C
      \u0432 \u043F\u043E\u0434\u043E\u0441\u043F\u0435\u0432\u0448\u0438\u0439 \u0432\u0430\u0433\u043E\u043D,
      \u043A\u043E\u0435-\u043A\u0430\u043A \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0430
      \u0440\u0443\u043A\u0443 \u0438 \u0443\u0445\u0432\u0430\u0442\u0438\u043B\u0430\u0441\u044C
      \u0437\u0430 \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u044C. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0431\u044B\u043B\u0430 \u043D\u0435\u0431\u043B\u0438\u0437\u043A\u0430\u044F,
      \u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0434\u043E\u0441\u0442\u0430\u0442\u044C
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C,
      \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u044B\u0435 \u044D\u043A\u0440\u0430\u043D\u044B
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043B\u0443\u0447\u0448\u0438\u043C
      \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435\u043C \u0434\u043B\u044F
      \u0421\u0438\u043B\u044C\u0432\u0438, \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u044F,
      \u0447\u0442\u043E \u0435\u0435 \u0433\u043E\u043B\u043E\u0432\u0430 \u0442\u043E\u0440\u0447\u0430\u043B\u0430
      \u0438\u0437 \u0442\u043E\u043B\u043F\u044B \u0440\u044B\u0436\u0438\u043C
      \u0444\u043E\u043D\u0430\u0440\u0435\u043C. "
