  - id: 0
    frameType: 0
    dialogueText: "\"Grapy-grapy! Always happy! \u0410\u041A\u0426\u0418\u042F! \u041F\u0440\u0438
      \u043F\u043E\u043A\u0443\u043F\u043A\u0435 \u0442\u0440\u0435\u0445 \u0433\u0430\u0437\u0438\u0440\u043E\u0432\u043E\u043A
      Grapy +15 \u043C\u0438\u043D\u0443\u0442 \u0412 \u041F\u041E\u0414\u0410\u0420\u041E\u041A!
      \u0422\u043E\u043B\u044C\u043A\u043E \u0432 \u0441\u0435\u0442\u0438 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432
      TrenteTroi\" "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: 5aef8628a33dd5a4f9a6155275418c3f, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
