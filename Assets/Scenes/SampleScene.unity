      - id: 0
        frameType: 0
        dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u0434\u0435\u0440\u043D\u0443\u043B\u0430
          \u0433\u0443\u0431\u0430\u043C\u0438, \u0443\u043A\u0443\u0441\u0438\u043B\u0430
          \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044E\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443
          \u0449\u0435\u043A\u0438, \u043F\u0440\u0438\u043A\u0438\u043D\u0443\u0432
          \u0432 \u0433\u043E\u043B\u043E\u0432\u0435 \u0448\u0438\u0440\u043E\u0442\u0443
          \u043C\u0430\u0440\u043A\u0435\u0442\u0438\u043D\u0433\u043E\u0432\u043E\u0433\u043E
          \u0444\u0430\u0440\u0441\u0430, \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
          \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0441\u0432\u043E\u0435\u0433\u043E
          \u0434\u043E\u043C\u0430. "
