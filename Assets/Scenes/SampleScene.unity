    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u043E\u0442\u043F\u0440\u044F\u043D\u0443\u043B\u0430,
      \u0437\u0430\u043F\u0438\u0445\u043D\u0443\u043B\u0430 \u043F\u043E\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u044E\u0449\u0438\u0435
      \u043B\u0430\u0434\u043E\u043D\u0438 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u044B
      \u0438 \u0432\u044B\u0448\u043B\u0430 \u0438\u0437 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430.  "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D\u0430 \u0434\u043E\u0441\u0442\u0430\u043B\u0430
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D, \u043E\u0442\u043A\u0440\u044B\u043B\u0430
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0439
      \u0441\u043F\u0438\u0441\u043E\u043A \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043E\u0432
      \u0438 \u0442\u043A\u043D\u0443\u043B\u0430 \u0432 \u0438\u043C\u044F, \u043D\u0430\u0431\u0440\u0430\u043B\u0430
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0432.
      \u041F\u043E\u043C\u0435\u0434\u043B\u0438\u043B\u0430 \u0438 \u043F\u0440\u043E\u0442\u044F\u0436\u043D\u043E
      \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B\u0430, \u0437\u0430\u0442\u0435\u043C
      \u0441\u0442\u0451\u0440\u043B\u0430 \u0438\u0445 \u0438 \u043D\u0430\u0436\u0430\u043B\u0430
      \u043D\u0430 \u0437\u043D\u0430\u0447\u043E\u043A \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043D\u043E\u0439
      \u0442\u0440\u0443\u0431\u043A\u0438. \u0427\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u044B\u0440\u0435
      \u0433\u0443\u0434\u043A\u0430 \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
      \u043C\u0443\u0436\u0441\u043A\u043E\u0439 \u0433\u043E\u043B\u043E\u0441.  "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
