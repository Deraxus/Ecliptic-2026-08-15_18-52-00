  - id: 0
    frameType: 0
    dialogueText: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u043D\u0430\u0434\u0430\u0432\u0438\u043B\u0430
      \u043D\u043E\u0441\u043A\u043E\u043C \u043D\u0430 \u043F\u044F\u0442\u043A\u0443,
      \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0430 \u043D\u043E\u0433\u0443 \u0438\u0437
      \u043E\u0434\u043D\u043E\u0433\u043E \u0431\u043E\u0442\u0438\u043D\u043A\u0430,
      \u0437\u0430\u0442\u0435\u043C \u0438\u0437 \u0432\u0442\u043E\u0440\u043E\u0433\u043E,
      \u043F\u0440\u043E\u0448\u043B\u0430 \u043F\u0430\u0440\u0443 \u0448\u0430\u0433\u043E\u0432
      \u0434\u043E \u043A\u0443\u0445\u043E\u043D\u043D\u043E\u0433\u043E \u0431\u043B\u043E\u043A\u0430
      \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0443\u0436\u0435
      \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0432\u0448\u0438\u0435\u0441\u044F
      \u0431\u0430\u043D\u043A\u0438 \u043D\u0430 \u043A\u0440\u0430\u0439 \u0442\u0443\u043C\u0431\u044B
      \u0440\u044F\u0434\u043E\u043C \u0441 \u043F\u043E\u0441\u0443\u0434\u043E\u0439,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0443\u0436\u0435
      \u0437\u0430\u0441\u043E\u0445\u043B\u0438 \u043E\u0441\u0442\u0430\u0442\u043A\u0438
      \u0435\u0434\u044B. \u041E\u043D\u0430 \u0432\u0437\u044F\u043B\u0430 \u043E\u0434\u043D\u0443
      \u0431\u0430\u043D\u043A\u0443, \u043E\u0442\u043A\u0440\u044B\u043B\u0430
      \u0438 \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043E\u0442\u043F\u0438\u043B\u0430
      \u2014 \u043F\u0440\u0438\u0442\u043E\u0440\u043D\u0430\u044F \u043A\u043E\u043B\u044E\u0447\u0430\u044F
      \u0432\u043E\u0434\u0430 \u043E\u0431\u0432\u043E\u043B\u043E\u043A\u043B\u0430
      \u043D\u043E\u044E\u0449\u0438\u0439 \u0436\u0435\u043B\u0443\u0434\u043E\u043A,
      \u0447\u0442\u043E \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0441\u0436\u0430\u043B\u0441\u044F
      \u043E\u0442 \u0434\u0435\u0448\u0435\u0432\u043E\u0433\u043E \u0430\u0440\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0442\u043E\u0440\u0430
      \u0432\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u0430. "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: 84c80b6cbb8f643429546a2b803dac98, type: 2}
