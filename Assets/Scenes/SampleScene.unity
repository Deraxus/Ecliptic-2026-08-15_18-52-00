  - id: 0
    frameType: 0
    dialogueText: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u0442\u044F\u0436\u0435\u043B\u043E
      \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B\u0430 \u0438 \u0437\u0430\u0436\u0430\u043B\u0430
      \u0431\u043E\u043A\u043E\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443
      \u0433\u0430\u0434\u0436\u0435\u0442\u0430 \u2014 \u044D\u043A\u0440\u0430\u043D
      \u043F\u043E\u0441\u043B\u0443\u0448\u043D\u043E \u043F\u043E\u0433\u0430\u0441,
      \u043D\u043E \u0440\u0443\u043A\u0430 \u043D\u0435 \u0441\u043F\u0435\u0448\u0438\u043B\u0430
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0442\u0435\u043B\u0435\u0444\u043E\u043D
      \u043D\u0430 \u043C\u0435\u0441\u0442\u043E. \u0417\u0435\u043B\u0435\u043D\u0430\u044F
      \u0440\u0430\u0434\u0443\u0436\u043A\u0430, \u0437\u0430\u043F\u0443\u0442\u0430\u043D\u043D\u0430\u044F
      \u0432 \u0441\u0435\u0442\u043A\u0435 \u0432\u0441\u043F\u0443\u0445\u0448\u0438\u0445
      \u043A\u0430\u043F\u0438\u043B\u043B\u044F\u0440\u043E\u0432, \u0437\u0430\u0441\u0442\u044B\u043B\u0430
      \u0432 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439
      \u043D\u0438\u0442\u044C\u044E \u043E\u0442\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u043B\u0430
      \u0434\u043B\u0438\u043D\u043D\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u043A\u0430
      \u0446\u0438\u0444\u0440, \u0438 \u043B\u0438\u0448\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u0434\u0432\u0435 \u043C\u0435\u0440\u043D\u043E \u043E\u0442\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0438
      \u0441\u0435\u043A\u0443\u043D\u0434\u044B. "
