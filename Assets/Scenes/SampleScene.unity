  - id: 0
    frameType: 0
    dialogueText: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u043E\u0442\u043A\u0438\u043D\u0443\u043B\u0430
      \u043F\u0430\u043A\u0435\u0442 \u0441 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043A\u0443\u0447\u043A\u0438 \u043C\u0438\u043A\u0440\u043E\u0441\u0445\u0435\u043C,
      \u043E\u0442\u0440\u044B\u043B\u0430 \u043E\u0442\u0442\u0443\u0434\u0430 \u0432\u0441\u043F\u043E\u0440\u043E\u0442\u044B\u0439
      \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B, \u0447\u0442\u043E-\u0442\u043E
      \u043F\u043E\u0442\u044B\u043A\u0430\u043B\u0430 \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439 \u043D\u0430
      \u0441\u0442\u043E\u043B. \u0412 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u043C
      \u043E\u043A\u043D\u0435 \u0441\u0442\u0430\u043B \u0432\u044B\u0440\u0438\u0441\u043E\u0432\u044B\u0432\u0430\u0442\u044C\u0441\u044F
      \u043A\u043E\u0434 \u043D\u043E\u0432\u043E\u0439 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B."
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
