    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\u0412 \u0446\u0435\u043B\u043E\u043C, \u043C\u043E\u0436\u043D\u043E.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0441\u0440\u043E\u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0432\u044B\u043F\u043B\u0430\u0442\u044B \u043D\u0435 \u0441\u0434\u0432\u0438\u043D\u0435\u0442\u0441\u044F. "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u0417\u043D\u0430\u044E, \u043D\u0438\u0447\u0435\u0433\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E. "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u0422\u043E\u0433\u0434\u0430 \u0441\u0435\u0439\u0447\u0430\u0441
      \u0433\u043B\u044F\u043D\u0443 \u0441\u0442\u0430\u0442\u0443\u0441, \u043E\u0444\u043E\u0440\u043C\u043B\u044E
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441, \u0430 \u0442\u044B \u0443\u0436\u0435
      \u0437\u0430\u0434\u043D\u0438\u043C \u0447\u0438\u0441\u043B\u043E\u043C \u0441\u043A\u0438\u043D\u044C
      \u043C\u043D\u0435 \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0430
      \u0440\u0430\u043D\u043D\u0438\u0439 \u043F\u0435\u0440\u0435\u0432\u043E\u0434,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C. "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u043A\u0438\u0432\u043D\u0443\u043B\u0430
      \u0438 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C,
      \u0441\u043E\u0431\u0438\u0440\u0430\u044F\u0441\u044C \u0443\u0439\u0442\u0438,
      \u043D\u043E \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C. "
