    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u201C60 \u043B\u044E\u043C\u0435\u043D\u043E\u0432 \u0437\u0430
      \u0434\u0435\u043D\u044C, \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E?
      \u042D\u0442\u043E \u043F\u043E\u0447\u0442\u0438 \u0434\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438
      \u0437\u0430 \u043C\u0435\u0441\u044F\u0446.\u201D "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
