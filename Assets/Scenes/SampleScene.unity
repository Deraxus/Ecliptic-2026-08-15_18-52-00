  - id: 0
    frameType: 1
    dialogueText: "\u201C\u0410 \u043F\u043E\u0442\u043E\u043C \"\u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0435\u043C
      \u0432\u044B\u043F\u043B\u0430\u0442\u044B \u0437\u0430 \u0434\u0432\u0435
      \u043D\u0435\u0434\u0435\u043B\u0438 \u0434\u043E \u041F\u043E\u0440\u043E\u0433\u0430\"...
      \u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0432\u044B \u0432\u0430\u0448\u0438\u043C
      \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
      \u0430\u0441\u0444\u0430\u043B\u044C\u0442 \u043F\u043E\u043B\u0438\u0432\u0430\u0435\u0442\u0435.\u201D "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
