    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u0427\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0447\u0430\u0441\u0430
      \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435 \u0432\u044B\u043F\u043B\u044E\u043D\u0443\u043B\u043E
      \u0421\u0438\u043B\u044C\u0432\u0438\u044E \u043D\u0430 \u0443\u043B\u0438\u0446\u0443
      \u041C\u0443\u0431\u0442\u0430\u043B, \u043E\u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u0438 \u0438\u0437\u0432\u0438\u043B\u0438\u0441\u0442\u044B\u0439 \u0441\u043F\u0430\u043B\u044C\u043D\u044B\u0439
      \u0440\u0430\u0439\u043E\u043D, \u0443\u0442\u043E\u043F\u0430\u044E\u0449\u0438\u0439
      \u0432 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u043C \u0434\u043E\u0436\u0434\u0435.
      \u041B\u044E\u0434\u0435\u0439 \u043C\u0435\u043D\u044C\u0448\u0435 \u043D\u0435
      \u0441\u0442\u0430\u043B\u043E, \u043E\u043D\u0438 \u0440\u0430\u0437\u0431\u0440\u0435\u043B\u0438\u0441\u044C
      \u043F\u043E \u0443\u043B\u0438\u0446\u0430\u043C \u043C\u0443\u0440\u0430\u0432\u044C\u044F\u043C\u0438. "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: ac790543ea776344c923f1f877579420, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
