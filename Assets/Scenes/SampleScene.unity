    dialogueText: "\u201C\u042D\u0442\u043E \u0447\u0435\u0433\u043E \u0437\u0430
      \u043F\u043E\u0433\u0440\u0435\u0448\u043D\u043E\u0441\u0442\u0438?\u201D "
