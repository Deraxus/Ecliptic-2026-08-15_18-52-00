  - id: 0
    frameType: 1
    dialogueText: "\"\u041C-\u0434\u0430, \u0434\u0430\u0440\u043E\u043C \u0441\u043A\u0430\u0447\u043E\u043A
      \u043D\u0435 \u043F\u0440\u043E\u0448\u0435\u043B. \u0417\u0430\u0434\u0440\u0430\u043B\u0438
      \u0446\u0435\u043D\u044B, \u043A\u0430\u043A \u043D\u0435\u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0435.\" "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
