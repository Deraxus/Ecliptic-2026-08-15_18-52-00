  - id: 0
    frameType: 0
    dialogueText: "\u041F\u0430\u043B\u044C\u0446\u044B \u0437\u0430\u0442\u0430\u0440\u0430\u0445\u0442\u0435\u043B\u0438
      \u043F\u043E \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435,
      \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B\u0441\u044F
      \u0441\u0430\u0439\u0442 \"RiT\". \u0421\u0438\u043B\u044C\u0432\u0438 \u043F\u0440\u043E\u043B\u0438\u0441\u0442\u0430\u043B\u0430
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443 \u0438 \u0441 \u043A\u0430\u0436\u0434\u044B\u043C
      \u0447\u0438\u0441\u043B\u043E\u043C, \u0447\u0442\u043E \u043F\u0440\u043E\u043F\u043B\u044B\u0432\u0430\u043B\u043E
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0435\u0439, \u0435\u0435 \u0431\u0440\u043E\u0432\u0438
      \u043D\u0435\u0432\u043E\u043B\u044C\u043D\u043E \u043D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043B\u043E\u0431. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
