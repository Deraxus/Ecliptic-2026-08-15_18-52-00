  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D\u0430 \u0432\u043D\u043E\u0432\u044C \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u043B\u0430
      \u043D\u0430 \u043E\u0442\u0447\u0435\u0442\u044B, \u0433\u0434\u0435 \u043C\u0435\u043B\u044C\u043A\u0430\u043B\u0438
      \u0435\u043B\u0435 \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0435 \u0446\u0438\u0444\u0440\u044B,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u043E \u044D\u0442\u043E\u0433\u043E
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0445\u043E\u0442\u0435\u043B
      \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
