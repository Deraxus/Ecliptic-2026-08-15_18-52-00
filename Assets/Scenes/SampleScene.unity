  - id: 0
    frameType: 0
    dialogueText: "\u0417\u0443\u0431\u044B \u0431\u043E\u043B\u044C\u043D\u043E
      \u0437\u0430\u0436\u0430\u043B\u0438 \u043A\u043E\u0436\u0443 \u0449\u0435\u043A\u0438
      \u0438\u0437\u043D\u0443\u0442\u0440\u0438, \u0432\u043E \u0440\u0442\u0443
      \u0437\u0430\u0438\u0433\u0440\u0430\u043B \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043F\u0440\u0438\u0432\u043A\u0443\u0441. \u0421\u0438\u043B\u044C\u0432\u0438
      \u043E\u0442\u043A\u0440\u044B\u043B\u0430 \u0435\u0449\u0435 \u043E\u0434\u0438\u043D
      \u0441\u0430\u0439\u0442: \u043D\u0430 \u0432\u0435\u0441\u044C \u044D\u043A\u0440\u0430\u043D
      \u0440\u0430\u0441\u043A\u0438\u043D\u0443\u043B\u0441\u044F \u0437\u0435\u043B\u0435\u043D\u044B\u0439
      \u0441\u0430\u0434 \u0438 \u043D\u0430\u0440\u043E\u0447\u0438\u0442\u043E
      \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0435 \u043B\u0438\u0446\u0430. "
    changeBackground: 0
