    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A \u0431\u044B\u0441\u0442\u0440\u043E
      \u0437\u0430\u0442\u0430\u0440\u0430\u0445\u0442\u0435\u043B \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438
      \u043F\u043E \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435. "
    changeBackground: 0
    frameBackground: {fileID: 0}
