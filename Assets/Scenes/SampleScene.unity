  - id: 0
    frameType: 1
    dialogueText: "\u201C\u042D\u0442\u0438 \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0443\u0445\u043E\u0434\u044F\u0442
