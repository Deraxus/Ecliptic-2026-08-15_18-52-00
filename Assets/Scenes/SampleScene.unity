  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u043E\u0442\u043A\u0440\u044B\u043B\u0430
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0430\u0439\u0442, \u043D\u0430
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0441\u0430\u043C\u044B\u043C \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u0448\u0440\u0438\u0444\u0442\u043E\u043C \u0432\u044B\u0432\u0435\u043B\u0441\u044F
      \u0433\u043E\u0440\u0434\u044B\u0439 \u0433\u0435\u0440\u0431 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
      \"Eon Industries\" \u0441 \u043A\u0443\u0440\u0441\u0438\u0432\u043D\u043E\u0439
      \u043F\u0440\u0438\u043F\u0438\u0441\u043A\u043E\u0439 \"\u0411\u0410\u041D\u041A\".
      \u0412\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0435\u0435 \u043B\u0438\u0446\u0430
      \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C. "
