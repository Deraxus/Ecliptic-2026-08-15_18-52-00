  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0445\u043E\u0434\u0438\u043B\u0430 \u0432 \u0434\u0443\u0448,
      \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u0430 \u0436\u0430\u043B\u044E\u0437\u0438
      \u0438 \u043F\u043B\u044E\u0445\u043D\u0443\u043B\u0430\u0441\u044C \u043D\u0430
      \u043A\u0440\u043E\u0432\u0430\u0442\u044C \u0440\u044F\u0434\u043E\u043C \u0441\u043E
      \u0441\u043A\u043E\u043C\u043A\u0430\u043D\u043D\u044B\u043C \u043E\u0434\u0435\u044F\u043B\u043E\u043C. "
