  - id: 0
    frameType: 0
    dialogueText: "\u041D\u0430\u043F\u0443\u0441\u043A\u043D\u043E\u0435 \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u0438\u0435
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\u0430 \u043F\u0440\u043E\u043F\u0430\u043B\u043E,
      \u043E\u043D \u043B\u0435\u043D\u0438\u0432\u043E \u0443\u0441\u0442\u0430\u0432\u0438\u043B\u0441\u044F
      \u0432 \u043C\u043E\u043D\u0438\u0442\u043E\u0440, \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
