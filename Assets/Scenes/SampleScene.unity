    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u201C\u0410, \u043A\u0440\u0435\u043C\u0430\u0446\u0438\u044F.
      \u041D\u0443...\u201D "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u0442\u044F\u0436\u0435\u043B\u043E
      \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B\u0430, \u043F\u043E\u0442\u0435\u0440\u043B\u0430
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0446\u0443 \u0438 \u0437\u0430\u0436\u043C\u0443\u0440\u0438\u043B\u0430\u0441\u044C,
      \u043F\u043E\u0434 \u0432\u0435\u043A\u0430\u043C\u0438 \u0431\u0443\u0434\u0442\u043E
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0438 \u0440\u0430\u0441\u043A\u0430\u043B\u0435\u043D\u043D\u044B\u0439
      \u043F\u0435\u0441\u043E\u043A. \u0420\u0430\u0437\u0434\u0430\u043B\u0441\u044F
      \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0449\u0435\u043B\u0447\u043E\u043A
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F. \u0421\u0438\u043B\u044C\u0432\u0438
      \u043F\u043E\u0434\u043D\u044F\u043B\u0430 \u0433\u043B\u0430\u0437\u0430,
      \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u0442\u043A\u043D\u0443\u043B\u0430
      \u0432 \u043D\u043E\u0432\u043E\u0435 \u043F\u0438\u0441\u044C\u043C\u043E. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u201C\u0417\u0430\u0431\u044B\u043B. \u041E\u043D\u0430 \u043F\u043E
      \u0441\u0441\u044B\u043B\u043A\u0435, \u0432\u0441\u0435 \u0434\u0430\u043D\u043D\u044B\u0435
      \u043F\u043E\u0434\u0442\u044F\u043D\u0435\u0448\u044C \u043E\u0442\u0442\u0443\u0434\u0430.
      \u0414\u043E\u0441\u0442\u0443\u043F \u0434\u0430\u043B.\u201D "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
