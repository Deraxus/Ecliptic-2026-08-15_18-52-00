  - id: 0
    frameType: 0
    dialogueText: "\u0423\u0448\u0438 \u0437\u0430\u0449\u0435\u043A\u043E\u0442\u0430\u043B
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u043F\u0438\u0441\u043A.
      \u0421\u0438\u043B \u043F\u043E\u0448\u0435\u0432\u0435\u043B\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435 \u0431\u044B\u043B\u043E, \u043D\u043E \u0434\u0435\u0432\u0443\u0448\u043A\u0430
      \u0443\u0436\u0435 \u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E \u0432\u044B\u0440\u0443\u0433\u0430\u043B\u0430\u0441\u044C
      \u043D\u0430 \u0441\u043E\u0441\u0435\u0434\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u0440\u0430\u0437
      \u0432\u044B\u0440\u0432\u0430\u043B \u0435\u0435 \u0438\u0437 \u0441\u043D\u0430. "
    changeBackground: 0
