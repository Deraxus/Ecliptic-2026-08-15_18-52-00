  - id: 0
    frameType: 1
    dialogueText: "\u201C\u041F\u043E\u0442\u043E\u043C \u043A\u0443\u043F\u043B\u044E
      \u0441\u0435\u0431\u0435 \u043F\u0430\u0440\u0443 \u043C\u0435\u0441\u044F\u0446\u0435\u0432,
      \u043F\u043E\u0436\u0438\u0432\u0443 \u043D\u0430 \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u043A\u0435,
      \u043D\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u0442\u044C. \u0417\u0430\u0442\u043E
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043C\u0435\u0441\u044F\u0446
      \u0448\u0438\u043A\u0430\u043D\u0443.\u201D "
    changeBackground: 0
