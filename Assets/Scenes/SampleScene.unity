  - id: 0
    frameType: 1
    dialogueText: "\u201C\u0415\u0441\u043B\u0438 \u043E\u043F\u044F\u0442\u044C
      \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0431\u0440\u0435\u0434 \u043D\u0435
      \u0432\u0432\u0435\u0434\u0443\u0442 \u0432 \u043E\u0431\u043E\u0440\u043E\u0442.\u201D "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 3
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u043A\u0438\u0432\u043D\u0443\u043B\u0430
      \u0441\u0430\u043C\u043E\u0439 \u0441\u0435\u0431\u0435, \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u0432\u043E\u0440\u043E\u0442 \u043A\u0443\u0440\u0442\u043A\u0438, \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E
      \u043F\u0440\u0438\u043B\u0438\u043F\u0448\u0438\u0439 \u043A \u0432\u0437\u043E\u043F\u0440\u0435\u0432\u0448\u0435\u0439
      \u0448\u0435\u0435, \u0438 \u043F\u043E\u0448\u043B\u0430 \u043A \u043B\u0438\u0444\u0442\u0443. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 3
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u041E\u0441\u0442\u0430\u0442\u043A\u0438 \u0440\u0430\u0431\u043E\u0447\u0435\u0433\u043E
      \u0434\u043D\u044F \u0442\u044F\u043D\u0443\u043B\u0438\u0441\u044C \u043C\u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0434\u043E\u043B\u0433\u043E, \u0443\u0437\u0435\u043B \u043F\u043E\u0434
      \u0440\u0435\u0431\u0440\u0430\u043C\u0438 \u043D\u0435 \u0434\u0430\u0432\u0430\u043B
      \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u0442\u044C\u0441\u044F.
      \u0421\u0438\u043B\u044C\u0432\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B\u0430
      \u0441\u0432\u043E\u044E \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0443\u044E
      \u043F\u043E\u0447\u0442\u0443 \u043A\u0430\u0436\u0434\u044B\u0435 \u0434\u0435\u0441\u044F\u0442\u044C
      \u043C\u0438\u043D\u0443\u0442, \u043D\u0430\u043F\u0430\u0440\u044B\u0432\u0430\u043B\u0430\u0441\u044C
      \u043D\u0430 \u043E\u0431\u0438\u043B\u0438\u0435 \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0445
      \u0430\u043A\u0446\u0438\u0439 \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439
      \u0438 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u043D\u043E \u0443\u0434\u0430\u043B\u044F\u043B\u0430
      \u0438\u0445. "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 3
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 0
    dialogueText: "\u041C\u0435\u0436\u0434\u0443 \u0434\u0435\u043B\u043E\u043C
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u043C\u0430\u044F\u0442\u044C\u0441\u044F
      \u0441 \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0430\u043C\u0438,
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438
      \u043E\u043D\u0430 \u043E\u0442\u0442\u043E\u0447\u0438\u043B\u0430 \u0434\u043E
      \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u0430, \u0438
      \u0442\u0435\u043F\u0435\u0440\u044C \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430\u044F, \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E
      \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0433\u0440\u044F\u0437\u043B\u0430
      \u0432 \u0437\u044B\u0431\u043A\u043E\u043C \u0431\u043E\u043B\u043E\u0442\u0435
      \u043E\u0434\u043D\u0438\u0445 \u0438 \u0442\u0435\u0445 \u0436\u0435 \u0441\u0442\u0440\u043E\u0447\u0435\u043A. "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
