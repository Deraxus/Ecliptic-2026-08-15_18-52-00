    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\"\u0414\u0432\u0435 \u043D\u0435\u0434\u0435\u043B\u0438 \u0434\u043E
      \u041F\u043E\u0440\u043E\u0433\u0430 \u2014 \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u044C
      \u0432\u044B\u043F\u043B\u0430\u0442\u044B. \u042D\u043A\u043E\u043D\u043E\u043C\u044F\u0442,
      \u043D\u0430 \u0447\u0435\u043C \u0432\u0438\u0434\u044F\u0442.\" "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: 762c35b2a6a36aa4793749843482c2b2, type: 2}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 3
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u0442\u044F\u0436\u0435\u043B\u043E
      \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B\u0430, \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u043B\u044F\u043C\u043A\u0443 \u0442\u044F\u0436\u0435\u043B\u043E\u0439 \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0439
      \u0441\u0443\u043C\u043A\u0438 \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
      \u043A \u0432\u043B\u0430\u0436\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0435
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439 \u0443\u043B\u0438\u0446\u044B,
      \u0433\u0434\u0435 \u0432\u043E\u0437\u0432\u044B\u0448\u0430\u043B\u043E\u0441\u044C
      \u0441\u0432\u0435\u0442\u044F\u0449\u0435\u0435\u0441\u044F \u0437\u0434\u0430\u043D\u0438\u0435
      \u0432 \u0444\u043E\u0440\u043C\u0435 \u0438\u0437\u043E\u0449\u0440\u0435\u043D\u043D\u043E\u0439
      \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u044B, \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0448\u0442\u043E\u0440\u043C\u043E\u0432\u044B\u043C\u0438 \u0432\u043E\u043B\u043D\u0430\u043C\u0438
      \u0431\u0438\u043B \u043D\u0430\u0440\u043E\u0434. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: 762c35b2a6a36aa4793749843482c2b2, type: 2}
