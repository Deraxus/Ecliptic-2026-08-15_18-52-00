    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u0421\u0434\u0435\u043B\u0430\u0435\u0448\u044C \u2014 \u044F
      \u0442\u0435\u0431\u0435 \u0441\u043A\u0438\u043D\u0443 \u043B\u0438\u0447\u043D\u043E
      \u0434\u0435\u043D\u044E\u0436\u043A\u0443 \u043D\u0430 \u0442\u0440\u0438
      \u0434\u043D\u044F. \u0421 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u044B
      \u0432\u0435\u0440\u043D\u0435\u0448\u044C \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u043F\u043E\u0434\u0436\u0430\u043B\u0430
      \u0433\u0443\u0431\u044B \u0438 \u043B\u0435\u0433\u043E\u043D\u044C\u043A\u043E
      \u0437\u0430\u043A\u0438\u0432\u0430\u043B\u0430, \u0435\u0435 \u0433\u043E\u043B\u043E\u0441,
      \u0438 \u0431\u0435\u0437 \u0442\u043E\u0433\u043E \u0442\u0438\u0445\u0438\u0439
      \u0438 \u043D\u0435\u043F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439,
      \u0441\u0442\u0435\u043B\u0438\u043B\u0441\u044F \u0431\u0435\u0437\u043E\u0431\u0438\u0434\u043D\u044B\u043C
      \u0431\u0440\u0438\u0437\u043E\u043C. "
    changeBackground: 0
    frameBackground: {fileID: 11400000, guid: eef6ce6568309004aa2e728a1ccf599d, type: 2}
