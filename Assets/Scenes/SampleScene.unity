  - id: 0
    frameType: 0
    dialogueText: "\u0421\u043E\u043D \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B
      \u043E\u043F\u044C\u044F\u043D\u044F\u044E\u0449\u0438\u043C\u0438 \u043E\u0431\u0440\u044B\u0432\u043A\u0430\u043C\u0438,
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u0441\u0432\u0435\u0442\u044F\u0449\u0430\u044F\u0441\u044F
      \u043E\u0442 \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u043E\u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0430
      \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430 \u0421\u0438\u043B\u044C\u0432\u0438
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0433\u043B\u0430\u0437\u0430,
      \u043D\u043E \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432
      \u043E\u043D\u0430 \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u043A \u0441\u0442\u0435\u043D\u0435 \u0438 \u043D\u044B\u0440\u043D\u0443\u043B\u0430
      \u0441 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u043F\u043E\u0434 \u043E\u0434\u0435\u044F\u043B\u043E,
      \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0432\u0448\u0438\u0441\u044C \u0432
      \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0439 \u0441\u043E\u043D. "
    changeBackground: 0
