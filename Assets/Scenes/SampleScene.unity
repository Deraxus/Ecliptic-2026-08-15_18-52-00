--- !u!114 &97044158
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 97044155}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 31dda9ae4dabc3449a9efe3a99e2ea93, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Ecliptic.Story.StoryManager
  startStoryFrames:
  - id: 0
    frameType: 0
    dialogueText: "\u201C\u0421\u0435\u0440\u0432\u0438\u0441 Right in Time \u2014
      \u044D\u0442\u043E \u043D\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435.
      \u042D\u0442\u043E \u0441\u0432\u043E\u0431\u043E\u0434\u0430. \u0421\u0432\u043E\u0431\u043E\u0434\u0430
      \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0430\u0442\u044C\u0441\u044F
      \u043A\u0430\u0436\u0434\u044B\u043C \u0434\u043D\u0451\u043C \u0441 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430
      \u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430.
      \u041D\u0430\u0448\u0438 \u0422\u0430\u0439\u043C\u0435\u0440\u044B \u043D\u0435
      \u043E\u0442\u043D\u0438\u043C\u0430\u044E\u0442 \u0443 \u0432\u0430\u0441
      \u0436\u0438\u0437\u043D\u044C. \u041E\u043D\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442
      \u0432\u0430\u043C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043D\u0430\u0434
      \u043D\u0435\u0439. \u0411\u043E\u044F\u0442\u044C\u0441\u044F \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438
      \u2014 \u0443\u0434\u0435\u043B \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E.
      \u041F\u0440\u0438\u0432\u044B\u043A\u0430\u0439\u0442\u0435 \u043A \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0441\u0442\u0438.
      Eon Industries. RiT. \u0422\u043E\u0447\u043D\u043E\u0441\u0442\u044C, \u0432
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0442\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u201D
      \u041E\u0442\u0440\u044B\u0432\u043E\u043A \u0438\u0437 \u0440\u0435\u043A\u043B\u0430\u043C\u044B
      RiT "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 0}
    characterSide: 0
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0426\u0432\u0435\u0442\u043D\u043E\u0435 \u043F\u043E\u043B\u043E\u0442\u043D\u043E
      \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432 \u0440\u044F\u0431\u0438\u043B\u043E
      \u043D\u0430 \u0448\u0438\u0440\u043E\u043A\u043E\u043C \u044D\u043A\u0440\u0430\u043D\u0435,
      \u0434\u043E\u0440\u043E\u0433\u043E\u043C \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C,
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u0438\u0441\u043A\u043B\u044E\u0447\u0430\u043B\u0430 \u043B\u044E\u0431\u043E\u0439
      \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442 \u0434\u043B\u044F
      \u0433\u043B\u0430\u0437. \u041C\u043E\u043D\u0438\u0442\u043E\u0440 \u0441\u0442\u043E\u044F\u043B
      \u043D\u0430 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043D\u043E\u043C
      \u0442\u0435\u0445\u043D\u0438\u043A\u043E\u0439 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u0441 \u0437\u0430\u0431\u043E\u0442\u043E\u0439
      \u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u0445. "
    changeBackground: 1
    frameBackground: {fileID: 11400000, guid: de418476c94c46e4099e060e429f9810, type: 2}
    character: {fileID: 11400000, guid: a2d7e4e7db2b78148a2c5d3fff08ae28, type: 2}
    characterSide: 1
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438 \u0441\u043F\u0443\u0441\u0442\u044F
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442 \u0443\u0441\u0435\u0440\u0434\u043D\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B \u0437\u0430 \u044D\u0442\u0438\u043C
      \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u043C \u0430\u0433\u0440\u0435\u0433\u0430\u0442\u043E\u043C
      \u043D\u0435 \u0438\u043C\u0435\u043B\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F \u043E \u043C\u043D\u0438\u043C\u043E\u043C
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435: \u043E\u043D\u0430 \u043B\u0435\u0436\u0430\u043B\u0430
      \u043D\u0430 \u0441\u043E\u0433\u043D\u0443\u0442\u043E\u0439 \u0432 \u043B\u043E\u043A\u0442\u0435
      \u0440\u0443\u043A\u0435 \u0432 \u0441\u0430\u043D\u0442\u0438\u043C\u0435\u0442\u0440\u0430\u0445
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u043E\u0442 \u0432\u044B\u043A\u0440\u0443\u0447\u0435\u043D\u043D\u043E\u0433\u043E
      \u043D\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E
      \u044F\u0440\u043A\u043E\u0441\u0442\u044C \u044D\u043A\u0440\u0430\u043D\u0430
      \u0438 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0440\u0443\u043A\u0438 \u0442\u0430\u0440\u0430\u0445\u0442\u0435\u043B\u0430
      \u043F\u043E \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435,
      \u0441\u0432\u0438\u0441\u0430\u044E\u0449\u0435\u0439 \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0441\u043E \u0441\u0442\u043E\u043B\u0430. "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 11400000, guid: 842fb4ab86611fe46b413178e6beed32, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u0423\u0448\u0438 \u0431\u044B\u043B\u0438 \u043F\u043B\u043E\u0442\u043D\u043E
      \u0437\u0430\u0431\u0438\u0442\u044B \u0441\u0438\u043B\u0438\u043A\u043E\u043D\u043E\u0432\u044B\u043C\u0438
      \u0432\u0441\u0442\u0430\u0432\u043A\u0430\u043C\u0438 \u043D\u0430\u0443\u0448\u043D\u0438\u043A\u043E\u0432,
      \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0440\u043E\u0432\u043D\u044B\u043C
      \u0440\u0438\u0442\u043C\u043E\u043C \u0441\u0442\u0435\u043B\u0438\u043B\u0430\u0441\u044C
      \u043D\u0435\u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u0430\u044F \u043C\u0435\u043B\u043E\u0434\u0438\u044F,
      \u0437\u0430\u0433\u043B\u0443\u0448\u0430\u044F \u043C\u043E\u043D\u043E\u0442\u043E\u043D\u043D\u044B\u0435
      \u0437\u0432\u0443\u043A\u0438 \u043E\u0444\u0438\u0441\u043D\u043E\u0439 \u0443\u0442\u0440\u043E\u0431\u044B. "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 0}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u041F\u043E \u0441\u0442\u043E\u043B\u0443 \u043F\u0440\u043E\u0448\u043B\u0430\u0441\u044C
      \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u044F, \u0432\u0437\u0433\u043B\u044F\u0434
      \u0434\u0435\u0432\u0443\u0448\u043A\u0438 \u0443\u043F\u0430\u043B \u043D\u0430
      \u0437\u0430\u0441\u0432\u0435\u0442\u0438\u0432\u0448\u0438\u0439\u0441\u044F
      \u044D\u043A\u0440\u0430\u043D \u0441\u043C\u0430\u0440\u0442\u0444\u043E\u043D\u0430.
      \u041E\u043D\u0430 \u0432\u044B\u0436\u0434\u0430\u043B\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0441\u0435\u043A\u0443\u043D\u0434, \u043F\u043E\u043A\u0430 \u044D\u043A\u0440\u0430\u043D
      \u043D\u0435 \u043F\u043E\u0433\u0430\u0441, \u0437\u0430\u0442\u0435\u043C
      \u043E\u0442\u043E\u0440\u0432\u0430\u043B\u0430 \u0440\u0443\u043A\u0443 \u043E\u0442
      \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u044B \u0438 \u0432\u0437\u044F\u043B\u0430\u0441\u044C
      \u0437\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D. \u041D\u043E\u0432\u043E\u0435
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435. \u0421\u0438\u043B\u044C\u0432\u0438
      \u0434\u0435\u0440\u043D\u0443\u043B\u0430 \u043F\u043E \u044D\u043A\u0440\u0430\u043D\u0443
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C, \u0440\u0430\u0441\u043A\u0440\u044B\u043B\u0430
      \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435, \u0437\u0430\u043F\u043E\u043B\u043E\u043D\u0438\u0432\u0448\u0435\u0435
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0433\u043E
      \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430. "
