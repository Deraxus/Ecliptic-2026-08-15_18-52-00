      statRequired: []
      storyFrames:
      - id: 0
        frameType: 1
        dialogueText: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435\u2026
          \u042F \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u0441\u0432\u0435\u0440\u0445\u0443\u0440\u043E\u0447\u043D\u043E,
          \u0431\u0440\u0430\u043B\u0430 \u0434\u0435\u0441\u044F\u0442\u043A\u0438
          \u0437\u0430\u0434\u0430\u0447 \u0441\u0432\u043E\u0438\u0445 \u043A\u043E\u043B\u043B\u0435\u0433. "
