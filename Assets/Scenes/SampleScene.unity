    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 0
    dialogueText: "\u041E\u043D\u0430 \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C,
      \u043D\u0435\u0440\u0432\u043D\u043E \u043D\u0430\u0445\u043C\u0443\u0440\u0438\u043B\u0430\u0441\u044C. "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 1
  - id: 0
    frameType: 1
    dialogueText: "\u0422\u0435\u0431\u0435 \u0434\u043E \u041F\u043E\u0440\u043E\u0433\u0430
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043E\u0434\u0438\u043D\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439. \u042D\u0442\u043E \u043C\u0435\u043D\u044C\u0448\u0435
      \u0434\u0432\u0443\u0445 \u043D\u0435\u0434\u0435\u043B\u044C. "
    changeBackground: 0
    frameBackground: {fileID: 0}
    character: {fileID: 11400000, guid: ce98428383c1fbb409440eb470534f66, type: 2}
    characterSide: 3
    clothesType: 0
    emotion: 0
    choices: []
    hideCharacters: 0
  - id: 0
    frameType: 1
    dialogueText: "\u041D\u0443\u2026 \u0434\u0430. \u042D\u0442\u043E \u0436\u0435
      \u043D\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430? "
    changeBackground: 0
    frameBackground: {fileID: 0}
