  - id: 0
    frameType: 0
    dialogueText: "\u0416\u0438\u043B\u044B\u0435 \u0431\u043B\u043E\u043A\u0438
      \u0443\u043B\u0438\u0446\u044B \u041C\u0443\u0431\u0442\u0430\u043B \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0438\u0441\u044C
      \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u043C \u0441\u043E\u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435\u043C
      \u0446\u0435\u043D\u044B \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430.
      \u041A\u0432\u0430\u0440\u0442\u0438\u0440\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
      \u0432 \u043F\u0435\u0448\u0435\u0439 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u0438
      \u043E\u0442 \u043C\u0435\u0442\u0440\u043E, \u0438\u043C\u0435\u043B\u0438
      \u0432\u0441\u0435 \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u043A\u0430\u0446\u0438\u0438,
      \u043D\u043E \u0441\u0430\u043C\u0438 \u043F\u043E \u0441\u0435\u0431\u0435
      \u0431\u044B\u043B\u0438 \u043D\u0438\u0447\u0442\u043E\u0436\u043D\u043E \u043C\u0430\u043B\u044B,
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430
      \u0432\u044B\u0434\u0435\u043B\u044F\u043B\u0430\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u0434 \u0441\u043E\u0432\u043C\u0435\u0449\u0435\u043D\u043D\u044B\u0439
      \u0441\u0430\u043D\u0443\u0437\u0435\u043B. \u0417\u0430\u0442\u043E \u0447\u0438\u0441\u0442\u043E
      \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E, \u0447\u0442\u043E
      \u0438 \u0431\u044B\u043B\u043E \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F
      \u043E\u0434\u0438\u043D\u043E\u043A\u043E\u0433\u043E \u0441\u0440\u0435\u0434\u043D\u0435\u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u0430 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438. "
