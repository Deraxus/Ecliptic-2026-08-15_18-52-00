  - id: 0
    frameType: 0
    dialogueText: "\u0421\u0438\u043B\u044C\u0432\u0438\u044F \u0441\u043D\u043E\u0432\u0430
      \u043D\u0430\u0442\u044F\u043D\u0443\u043B\u0430 \u043A\u0443\u0440\u0442\u043A\u0443
      \u043D\u0430 \u043C\u0430\u043A\u0443\u0448\u043A\u0443, \u043D\u0430\u043A\u043E\u043D\u0435\u0446
      \u0434\u043E\u0441\u0442\u0430\u043B\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D,
      \u0442\u043A\u043D\u0443\u043B\u0430 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u0432 \u044D\u043A\u0440\u0430\u043D, \u0441\u043C\u0435\u043D\u0438\u0432
      \u043C\u0443\u0437\u044B\u043A\u0443, \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
      \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0443\u044E \u043F\u043E\u0434
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435, \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u043C
      \u0448\u0430\u0433\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
      \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439
      \u043A \u0434\u043E\u043C\u0443. "
